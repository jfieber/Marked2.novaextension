{
  "identifier": "org.ursamaris.nova.marked2",
  "name": "Marked",
  "organization": "John Fieber",
  "description": "View Markdown files with Marked.",
  "version": "1.2.0",
  "categories": ["commands"],
  "repository": "https://github.com/jfieber/Marked2.novaextension",
  "bugs": "https://github.com/jfieber/Marked2.novaextension/issues",
  "license": "MIT",
  "main": "main.js",
  "activationEvents": ["onLanguage:markdown"],
  "entitlements": {
    "process": true,
    "filesystem": "readonly"
  },

  "config": [
    {
      "key": "org.ursamaris.nova.marked2.markedPath",
      "title": "Marked Path",
      "description": "The path to the Marked application. If unset, the newest installed version of Marked will be used.",
      "type": "path",
      "filetype": ["com.apple.application-bundle"]
    }
  ],

  "commands": {
    "editor": [
      {
        "title": "View in Marked",
        "command": "marked.runMarked",
        "when": "editorHasFocus && documentHasPath && editorSyntax == 'markdown'"
      }
    ]
  }
}
